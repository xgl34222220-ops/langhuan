<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Langhuan" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/langhuan_window_v95</item>
        <item name="android:navigationBarColor">@color/langhuan_window_v95</item>
        <item name="android:statusBarColor">@color/langhuan_window_v95</item>
    </style>

    <!-- V95 launch screen (androidx SplashScreen: system splash on API 31+, emulated below). -->
    <style name="Theme.Langhuan.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/langhuan_window_v95</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark_v95</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Langhuan</item>
    </style>
</resources>
